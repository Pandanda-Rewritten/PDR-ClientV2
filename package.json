{
  "name": "PandandaRewritten",
  "productName": "Pandanda Rewritten",
  "version": "2.1.0",
  "description": "PDR-ClientV2 is a custom client for a Pandanda private server.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "publish-windows": "electron-forge publish",
    "publish-mac": "electron-forge publish --arch=x64",
    "publish-git": "electron-forge publish",
    "lint": "echo \"No linting configured\""
  },
  "keywords": [],
  "author": "Pandanda Rewritten",
  "license": "MIT",
  "config": {
    "forge": "./forge.config.js"
  },
  "build": {
    "extraResources": [
      {
        "from": "./lib/",
        "to": "lib",
        "filter": [
          "**/*"
        ]
      }
    ],
    "appId": "com.pdr.pdrcv2",
    "productName": "Pandanda Rewritten",
    "copyright": "Copyright © 2026 ${author}",
    "mac": {
      "icon": "./lib/icons/icon.icns",
      "category": "lib.games.pdr"
    },
    "win": {
      "icon": "./lib/icons/icon.png"
    },
    "directories": {
      "buildResources": "lib"
    },
    "protocols": [
      {
        "name": "pdr",
        "schemes": [
          "pdr"
        ]
      }
    ]
  },
  "dependencies": {
    "async-dialog": "0.0.1",
    "dialogs": "2.0.1",
    "discord-rpc": "4.0.1",
    "electron-prompt": "1.6.0",
    "electron-squirrel-startup": "1.0.0",
    "es5-ext": "<=0.10.53",
    "update-electron-app": "2.0.1"
  },
  "optionalDependencies": {
    "@malept/electron-installer-flatpak": "^0.11.4",
    "electron-installer-debian": "^3.0.0",
    "electron-installer-redhat": "^3.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.54",
    "@electron-forge/maker-appx": "^6.0.0-beta.54",
    "@electron-forge/maker-deb": "^6.0.0-beta.54",
    "@electron-forge/maker-dmg": "^6.0.0-beta.54",
    "@electron-forge/maker-flatpak": "^6.0.0-beta.64",
    "@electron-forge/maker-rpm": "^6.0.0-beta.54",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.54",
    "@electron-forge/maker-zip": "^6.0.0-beta.54",
    "@electron-forge/publisher-github": "^6.0.0-beta.54",
    "electron": "11.1.1",
    "electron-installer-dmg": "3.0.0"
  }
}
